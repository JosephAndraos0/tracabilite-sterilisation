rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // L'appareil se connecte en mode anonyme (voir src/firebase.js), donc
    // request.auth existe toujours pour un usage normal de l'app. Ça bloque
    // les lectures/écritures depuis l'extérieur de l'app.
    match /sterilisateurs/{docId} {
      allow read, write: if request.auth != null;
    }
    match /charges/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
